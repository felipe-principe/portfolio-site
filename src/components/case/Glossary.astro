---
// Glossário da página de case: termos de operação ganham sublinhado pontilhado com uma
// explicação curta (passar o mouse, focar com o teclado ou tocar). O painel lateral lista
// todos os termos que aparecem na página. Abre por qualquer elemento [data-open-glossario].
import { glossario } from '../../data/glossario';
const dados = JSON.stringify(glossario.map(({ id, termo, sigla, def, calc, aliases }) => ({ id, termo, sigla, def, calc, aliases })));
---
<div class="gl-tip" id="gl-tip" role="tooltip" data-gl-tip hidden>
  <p class="gl-tip-head"><b data-tip-termo></b><span class="gl-sigla" data-tip-sigla></span></p>
  <p class="gl-tip-def" data-tip-def></p>
  <p class="gl-tip-calc" data-tip-calc><span class="tag">Como calcula</span><span data-tip-calc-txt></span></p>
  <button class="gl-tip-more" type="button" data-tip-more>Ver glossário completo →</button>
</div>

<dialog class="gl-panel" data-gl-panel aria-labelledby="gl-title">
  <div class="gl-inner" data-lenis-prevent>
    <div class="gl-top">
      <div>
        <p class="tag">Glossário</p>
        <h2 class="gl-title" id="gl-title">Termos deste case</h2>
      </div>
      <button class="gl-close" type="button" data-gl-close aria-label="Fechar glossário">✕</button>
    </div>
    <p class="gl-intro">Termos de operação de atendimento usados neste case, com a forma de cálculo dos dashboards.</p>
    <dl class="gl-list">
      {glossario.map(t => (
        <div class="gl-item" id={`gl-${t.id}`} data-gl-item={t.id}>
          <dt><span class="gl-name">{t.termo}</span>{t.sigla && <span class="gl-sigla">{t.sigla}</span>}</dt>
          <dd>{t.def}</dd>
          {t.calc && <dd class="gl-calc"><span class="tag">Como calcula</span>{t.calc}</dd>}
        </div>
      ))}
    </dl>
  </div>
</dialog>
<script type="application/json" id="gl-data" set:html={dados} />

<style>
  /* ----- termo no texto ----- */
  :global(.gl-term) {
    font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: help;
    text-decoration: underline dotted rgba(76,201,240,.55); text-decoration-thickness: 1.5px; text-underline-offset: 3px;
    transition: text-decoration-color .2s ease, color .2s ease;
  }
  :global(.gl-term:hover), :global(.gl-term[aria-expanded="true"]) { text-decoration-color: var(--accent); color: var(--text); }

  /* ----- balão ----- */
  .gl-tip {
    position: fixed; z-index: 60; width: min(320px, calc(100vw - 32px)); padding: 14px 16px; border-radius: 14px;
    background: rgba(14,19,32,.97); backdrop-filter: blur(12px); box-shadow: 0 0 0 1px rgba(76,201,240,.3), 0 24px 50px -20px rgba(0,0,0,.9);
    opacity: 0; transform: translateY(4px); transition: opacity .15s ease, transform .2s var(--ease-out);
  }
  .gl-tip:global(.is-on) { opacity: 1; transform: none; }
  .gl-tip[hidden] { display: none; }
  .gl-tip-head { display: flex; align-items: baseline; gap: 8px; font-size: 14px; }
  .gl-tip-def { margin-top: 6px; font-size: 13.5px; line-height: 1.5; color: var(--text-2); }
  .gl-tip-calc { margin-top: 8px; font-family: var(--mono); font-size: 11.5px; line-height: 1.5; color: var(--text); }
  .gl-tip-calc .tag { display: block; color: var(--accent); margin-bottom: 2px; font-size: 10px; }
  .gl-tip-more { margin-top: 10px; font-size: 12.5px; color: var(--accent); }
  .gl-sigla { font-family: var(--mono); font-size: 11px; color: var(--accent); padding: 1px 7px; border-radius: 999px; border: 1px solid rgba(76,201,240,.35); }

  /* ----- painel lateral ----- */
  .gl-panel {
    margin: 0 0 0 auto; width: min(440px, 100vw); height: 100dvh; max-height: none; max-width: none;
    border: 0; padding: 0; background: var(--surface); color: var(--text);
    box-shadow: -1px 0 0 var(--border), -40px 0 80px -20px rgba(0,0,0,.8);
    transform: translateX(100%); transition: transform .35s var(--ease-out);
  }
  .gl-panel:global(.is-open) { transform: none; }
  .gl-panel::backdrop { background: rgba(3,5,9,.6); backdrop-filter: blur(3px); }
  .gl-inner { height: 100%; overflow-y: auto; padding: 28px 28px 48px; overscroll-behavior: contain; }
  .gl-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .gl-title { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.03em; margin-top: 8px; }
  .gl-close { width: 38px; height: 38px; flex: none; border-radius: 50%; border: 1px solid var(--border); transition: border-color .2s ease; }
  .gl-close:hover { border-color: var(--accent); }
  .gl-intro { margin-top: 12px; font-size: 14px; color: var(--text-2); }
  .gl-list { margin-top: 24px; display: grid; gap: 4px; }
  .gl-item { padding: 16px 14px; border-radius: 12px; transition: background-color .4s ease; }
  .gl-item[hidden] { display: none; }
  .gl-item:global(.is-focus) { background: rgba(76,201,240,.08); }
  .gl-item dt { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .gl-name { font-weight: 600; font-size: 15.5px; }
  .gl-item dd { margin-top: 6px; font-size: 14px; line-height: 1.55; color: var(--text-2); }
  .gl-item dd.gl-calc { font-family: var(--mono); font-size: 12px; color: var(--text); }
  .gl-calc .tag { display: block; color: var(--accent); font-size: 10px; margin-bottom: 2px; }
  @media (prefers-reduced-motion: reduce) { .gl-panel, .gl-tip { transition: opacity .15s ease; transform: none; } }
</style>

<script>
  interface Termo { id: string; termo: string; sigla?: string; def: string; calc?: string; aliases: { re: string; cs?: boolean }[] }
  const termos: Termo[] = JSON.parse(document.getElementById('gl-data')!.textContent!);
  const porId = new Map(termos.map(t => [t.id, t]));

  // ---------- 1. Marcar os termos no texto ----------
  // Só a primeira aparição de cada termo por seção, e nunca em código, tabelas, títulos ou botões.
  const SKIP = 'pre, code, table, h1, h2, h3, button, a, .tag, nav, dialog, [data-gl-tip], .chips, .facts, .tabs, [aria-hidden="true"]';
  const LETRA = '[\\p{L}\\p{N}]';
  const padroes = termos.flatMap(t => t.aliases.map(a => ({ id: t.id, re: new RegExp(`(?<!${LETRA})(?:${a.re})(?!${LETRA})`, a.cs ? 'u' : 'iu') })));
  const presentes = new Set<string>();

  document.querySelectorAll<HTMLElement>('main section, main header').forEach(sec => {
    const usados = new Set<string>();
    const walker = document.createTreeWalker(sec, NodeFilter.SHOW_TEXT, {
      acceptNode: n => (!n.nodeValue?.trim() || n.parentElement?.closest(SKIP) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
    });
    const nos: Text[] = [];
    while (walker.nextNode()) nos.push(walker.currentNode as Text);
    for (let node of nos) {
      // repete enquanto houver termos novos neste trecho de texto
      for (;;) {
        let melhor: { id: string; idx: number; len: number } | null = null;
        for (const p of padroes) {
          const m = p.re.exec(node.nodeValue!);
          if (m) presentes.add(p.id);
          if (!m || usados.has(p.id)) continue;
          if (!melhor || m.index < melhor.idx) melhor = { id: p.id, idx: m.index, len: m[0].length };
        }
        if (!melhor) break;
        usados.add(melhor.id);
        const alvo = node.splitText(melhor.idx);
        const resto = alvo.splitText(melhor.len);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'gl-term';
        btn.dataset.term = melhor.id;
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-describedby', 'gl-tip');
        btn.textContent = alvo.nodeValue;
        alvo.replaceWith(btn);
        node = resto;
      }
    }
  });

  // ---------- 2. Balão ----------
  const tip = document.querySelector<HTMLElement>('[data-gl-tip]')!;
  const $ = (s: string) => tip.querySelector<HTMLElement>(s)!;
  let ativo: HTMLElement | null = null;
  let timer = 0;
  let abertoEm = 0; // no toque, o foco abre o balão logo antes do clique; o clique não pode fechá-lo
  const fino = matchMedia('(hover: hover) and (pointer: fine)').matches;

  function mostrar(el: HTMLElement) {
    clearTimeout(timer);
    const t = porId.get(el.dataset.term!)!;
    if (ativo && ativo !== el) ativo.setAttribute('aria-expanded', 'false');
    ativo = el;
    el.setAttribute('aria-expanded', 'true');
    $('[data-tip-termo]').textContent = t.termo;
    $('[data-tip-sigla]').textContent = t.sigla ?? '';
    $('[data-tip-sigla]').hidden = !t.sigla;
    $('[data-tip-def]').textContent = t.def;
    $('[data-tip-calc]').hidden = !t.calc;
    $('[data-tip-calc-txt]').textContent = t.calc ?? '';
    tip.hidden = false;
    const r = el.getBoundingClientRect();
    const w = tip.offsetWidth, h = tip.offsetHeight;
    const left = Math.max(16, Math.min(innerWidth - w - 16, r.left + r.width / 2 - w / 2));
    const acima = r.top - h - 10 > 70;
    tip.style.left = `${left}px`;
    tip.style.top = `${acima ? r.top - h - 10 : r.bottom + 10}px`;
    abertoEm = performance.now();
    requestAnimationFrame(() => tip.classList.add('is-on'));
  }
  function esconder(agora = false) {
    clearTimeout(timer);
    const fn = () => {
      tip.classList.remove('is-on');
      ativo?.setAttribute('aria-expanded', 'false');
      ativo = null;
      setTimeout(() => { if (!ativo) tip.hidden = true; }, 160);
    };
    agora ? fn() : (timer = window.setTimeout(fn, 140));
  }
  document.addEventListener('pointerover', e => {
    if (!fino) return;
    const el = (e.target as HTMLElement).closest<HTMLElement>('.gl-term');
    if (el) { timer = window.setTimeout(() => mostrar(el), ativo ? 0 : 90); return; }
    if ((e.target as HTMLElement).closest('[data-gl-tip]')) { clearTimeout(timer); return; }
  });
  document.addEventListener('pointerout', e => {
    if (!fino) return;
    const de = (e.target as HTMLElement).closest('.gl-term, [data-gl-tip]');
    const para = (e.relatedTarget as HTMLElement | null)?.closest?.('.gl-term, [data-gl-tip]');
    if (de && !para) esconder();
  });
  document.addEventListener('click', e => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.gl-term');
    if (el) { ativo === el && !fino && performance.now() - abertoEm > 400 ? esconder(true) : mostrar(el); return; }
    if (!(e.target as HTMLElement).closest('[data-gl-tip]')) esconder(true);
  });
  document.addEventListener('focusin', e => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.gl-term');
    if (el) mostrar(el);
  });
  document.addEventListener('focusout', e => {
    if ((e.target as HTMLElement).closest('.gl-term') && !tip.contains(e.relatedTarget as Node)) esconder();
  });
  addEventListener('keydown', e => { if (e.key === 'Escape' && ativo) { const el = ativo; esconder(true); el.focus(); } });
  addEventListener('scroll', () => { if (ativo) esconder(true); }, { passive: true });

  // ---------- 3. Painel lateral ----------
  const painel = document.querySelector<HTMLDialogElement>('[data-gl-panel]')!;
  // só os termos que aparecem nesta página
  painel.querySelectorAll<HTMLElement>('[data-gl-item]').forEach(it => { it.hidden = !presentes.has(it.dataset.glItem!); });
  if (presentes.size === 0) document.querySelectorAll<HTMLElement>('[data-open-glossario]').forEach(b => (b.hidden = true));

  function abrir(id?: string) {
    esconder(true);
    painel.showModal();
    requestAnimationFrame(() => painel.classList.add('is-open'));
    painel.querySelectorAll('.is-focus').forEach(n => n.classList.remove('is-focus'));
    if (id) {
      const item = painel.querySelector<HTMLElement>(`#gl-${id}`);
      if (item) {
        item.classList.add('is-focus');
        setTimeout(() => item.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }), 200);
      }
    }
  }
  function fechar() {
    painel.classList.remove('is-open');
    setTimeout(() => painel.close(), 300);
  }
  $('[data-tip-more]').addEventListener('click', () => abrir(ativo?.dataset.term));
  document.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-open-glossario]');
    if (b) abrir();
  });
  painel.querySelector('[data-gl-close]')!.addEventListener('click', fechar);
  painel.addEventListener('cancel', e => { e.preventDefault(); fechar(); });
  painel.addEventListener('click', e => { if (e.target === painel) fechar(); });
</script>
