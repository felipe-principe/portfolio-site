---
// Pílula flutuante da página do case: mostra o capítulo atual e o progresso de leitura.
// Clicar abre a lista de capítulos para pular direto. Os capítulos vêm das seções com data-chapter.
// Ao lado, o atalho fixo para o dashboard interativo: quem já viu o que queria abre na hora.
interface Props { pbiUrl?: string }
const { pbiUrl } = Astro.props;
---
<nav class="chap" data-chap aria-label="Capítulos do case">
  <div class="panel" id="chap-list" data-panel hidden>
    <ol class="list" data-list></ol>
  </div>
  <div class="dock">
  <button class="pill" type="button" aria-expanded="false" aria-controls="chap-list" data-pill>
    <span class="count num"><b data-cur>01</b>/<span data-total>09</span></span>
    <span class="name-wrap"><span class="name" data-name>—</span></span>
    <span class="chev" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"><i data-bar></i></span>
  </button>
  <button class="gl-btn" type="button" data-open-glossario aria-label="Abrir glossário" title="Glossário de termos">
    <span class="gl-ico" aria-hidden="true">Aa</span><span class="gl-txt">Glossário</span>
  </button>
  {pbiUrl && (
    <button class="go-live" type="button" data-open-pbi={pbiUrl}>
      <span class="live" aria-hidden="true"></span><span class="full">Abrir dashboard</span><span class="short">Ao vivo</span>
    </button>
  )}
  </div>
</nav>

<style>
  .chap {
    position: fixed; left: 50%; bottom: 20px; z-index: 30;
    transform: translate(-50%, 24px); opacity: 0; pointer-events: none;
    transition: transform .4s var(--ease-out), opacity .3s ease;
  }
  .chap:global(.is-visible) { transform: translate(-50%, 0); opacity: 1; pointer-events: auto; }

  .dock { display: flex; align-items: center; gap: 8px; }
  .gl-btn {
    display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 16px; border-radius: 999px; white-space: nowrap;
    font-size: 14px; color: var(--text-2); background: rgba(14,19,32,.82); backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 0 0 1px var(--border), 0 20px 50px -20px rgba(0,0,0,.9); transition: color .2s ease, box-shadow .2s ease;
  }
  .gl-btn:hover { color: var(--text); box-shadow: 0 0 0 1px rgba(76,201,240,.45), 0 20px 50px -20px rgba(0,0,0,.9); }
  .gl-ico { font-family: var(--mono); font-size: 11px; color: var(--accent); }
  .go-live {
    display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 20px; border-radius: 999px; white-space: nowrap;
    font-size: 14px; font-weight: 500; color: var(--bg); background: var(--accent);
    box-shadow: 0 20px 50px -20px rgba(0,0,0,.9), 0 8px 30px -10px rgba(76,201,240,.55);
    transition: transform .2s var(--ease-out), box-shadow .3s var(--ease-out);
  }
  .go-live:active { transform: scale(.97); }
  @media (hover: hover) and (pointer: fine) { .go-live:hover { transform: translateY(-2px); box-shadow: 0 20px 50px -20px rgba(0,0,0,.9), 0 12px 40px -8px rgba(76,201,240,.7); } }
  .go-live .live { width: 7px; height: 7px; border-radius: 50%; background: #0B5D3E; animation: live 2s ease-out infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(11,93,62,.5); } 70%, 100% { box-shadow: 0 0 0 7px rgba(11,93,62,0); } }
  .go-live .short { display: none; }
  .pill {
    position: relative; display: flex; align-items: center; gap: 12px; height: 48px; padding: 0 16px 0 18px;
    border-radius: 999px; overflow: hidden; white-space: nowrap;
    background: rgba(14,19,32,.82); backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 0 0 1px var(--border), 0 20px 50px -20px rgba(0,0,0,.9);
    transition: box-shadow .2s ease, transform .2s var(--ease-out);
  }
  .pill:active { transform: scale(.97); }
  @media (hover: hover) and (pointer: fine) { .pill:hover { box-shadow: 0 0 0 1px rgba(76,201,240,.45), 0 20px 50px -20px rgba(0,0,0,.9); } }
  .count { font-family: var(--mono); font-size: 12px; color: var(--text-2); }
  .count b { color: var(--accent); font-weight: 500; }
  .name-wrap { position: relative; display: block; overflow: hidden; height: 22px; min-width: 150px; text-align: left; }
  .name { display: block; font-size: 14px; font-weight: 500; line-height: 22px; }
  .chev { width: 8px; height: 8px; border-right: 1.5px solid var(--text-2); border-bottom: 1.5px solid var(--text-2); transform: translateY(2px) rotate(-135deg); transition: transform .3s var(--ease-out); }
  .pill[aria-expanded="true"] .chev { transform: translateY(-2px) rotate(45deg); }
  .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(28,35,51,.8); }
  .bar i { position: absolute; inset: 0; background: linear-gradient(90deg, var(--blue), var(--accent)); transform: scaleX(0); transform-origin: left; }

  .panel {
    position: absolute; left: 0; bottom: calc(100% + 10px); width: 280px; padding: 8px;
    border-radius: 18px; background: rgba(14,19,32,.94); backdrop-filter: blur(16px);
    box-shadow: 0 0 0 1px var(--border), 0 30px 70px -20px rgba(0,0,0,.95);
    transform-origin: 30% 100%; transform: scale(.96); opacity: 0;
    transition: transform .2s var(--ease-out), opacity .15s ease;
  }
  .panel[hidden] { display: none; }
  .panel:global(.is-open) { transform: scale(1); opacity: 1; }
  .list { list-style: none; }
  .list :global(a) { display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px; font-size: 14px; color: var(--text-2); transition: background-color .15s ease, color .15s ease; }
  .list :global(a:hover), .list :global(a:focus-visible) { background: rgba(76,201,240,.08); color: var(--text); }
  .list :global(a .k) { font-family: var(--mono); font-size: 11px; color: var(--text-2); width: 18px; }
  .list :global(a[aria-current="true"]) { color: var(--text); }
  .list :global(a[aria-current="true"] .k) { color: var(--accent); }
  .list :global(a[aria-current="true"])::after { content: ''; margin-left: auto; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }

  @media (max-width: 520px) {
    .name-wrap { min-width: 96px; }
    .chap { bottom: 14px; }
    .pill { gap: 8px; padding: 0 12px 0 14px; }
    .go-live { padding: 0 14px; }
    .go-live .full { display: none; }
    .gl-btn { width: 48px; padding: 0; justify-content: center; }
    .gl-txt { display: none; }
    .go-live .short { display: inline; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, getLenis, reduced } from '../../scripts/motion';

  const nav = document.querySelector<HTMLElement>('[data-chap]');
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  if (nav && chapters.length) {
    const pill = nav.querySelector<HTMLButtonElement>('[data-pill]')!;
    const panel = nav.querySelector<HTMLElement>('[data-panel]')!;
    const list = nav.querySelector<HTMLOListElement>('[data-list]')!;
    const cur = nav.querySelector<HTMLElement>('[data-cur]')!;
    const nameEl = nav.querySelector<HTMLElement>('[data-name]')!;
    const bar = nav.querySelector<HTMLElement>('[data-bar]')!;
    const pad = (n: number) => String(n).padStart(2, '0');

    nav.querySelector('[data-total]')!.textContent = pad(chapters.length);
    list.innerHTML = chapters.map((c, i) => `<li><a href="#${c.id}" data-i="${i}"><span class="k">${pad(i + 1)}</span>${c.dataset.chapter}</a></li>`).join('');
    const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];

    // Troca do nome do capítulo: o antigo sobe e sai, o novo sobe e entra.
    let active = -1;
    function setActive(i: number) {
      if (i === active) return;
      const dir = i > active ? 1 : -1;
      active = i;
      cur.textContent = pad(i + 1);
      links.forEach((a, j) => a.setAttribute('aria-current', String(j === i)));
      if (reduced) { nameEl.textContent = chapters[i].dataset.chapter!; return; }
      gsap.to(nameEl, {
        yPercent: -100 * dir, opacity: 0, duration: 0.15, ease: 'power2.out', overwrite: true,
        onComplete: () => {
          nameEl.textContent = chapters[i].dataset.chapter!;
          gsap.fromTo(nameEl, { yPercent: 100 * dir, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.25, ease: 'expo.out' });
        },
      });
    }
    chapters.forEach((c, i) => ScrollTrigger.create({
      trigger: c, start: 'top 55%', end: 'bottom 55%',
      onToggle: self => { if (self.isActive) setActive(i); },
    }));

    // Aparece depois da abertura e some quando o rodapé entra (para não cobrir o contato).
    const footer = document.querySelector('footer');
    let afterOpen = false, beforeFooter = true;
    const sync = () => nav.classList.toggle('is-visible', afterOpen && beforeFooter);
    ScrollTrigger.create({ trigger: chapters[0], start: 'top 80%', end: 'max', onToggle: s => { afterOpen = s.isActive; sync(); } });
    if (footer) ScrollTrigger.create({ trigger: footer, start: 'top bottom', onToggle: s => { beforeFooter = !s.isActive; sync(); if (!beforeFooter) setOpen(false); } });

    // Progresso de leitura do primeiro ao último capítulo.
    gsap.to(bar, {
      scaleX: 1, ease: 'none',
      scrollTrigger: { trigger: chapters[0], start: 'top 55%', endTrigger: chapters.at(-1), end: 'bottom bottom', scrub: true },
    });

    // Lista de capítulos
    let open = false;
    function setOpen(next: boolean) {
      if (next === open) return;
      open = next;
      pill.setAttribute('aria-expanded', String(open));
      if (open) { panel.hidden = false; requestAnimationFrame(() => panel.classList.add('is-open')); }
      else { panel.classList.remove('is-open'); setTimeout(() => { if (!open) panel.hidden = true; }, 200); }
    }
    pill.addEventListener('click', () => setOpen(!open));
    addEventListener('keydown', e => { if (e.key === 'Escape' && open) { setOpen(false); pill.focus(); } });
    document.addEventListener('pointerdown', e => { if (open && !nav.contains(e.target as Node)) setOpen(false); });
    links.forEach(a => a.addEventListener('click', e => {
      e.preventDefault();
      const target = chapters[+a.dataset.i!];
      setOpen(false);
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(target, { offset: -72, duration: 1.2 });
      else target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
      history.replaceState(null, '', `#${target.id}`);
    }));
  }
</script>
